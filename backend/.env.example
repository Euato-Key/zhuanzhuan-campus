# 服务配置
PORT=3000
NODE_ENV=development

# 数据库 - MySQL
DATABASE_URL=mysql://root:password@localhost:3306/zhuanzhuan_campus

# JWT
JWT_ACCESS_SECRET=your-access-secret-key
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# 邮箱 - QQ 邮箱 SMTP
QQ_EMAIL=your_email@qq.com
SMTP_AUTH_CODE=your-smtp-auth-code

# 前端地址（CORS）
CLIENT_ORIGIN=http://localhost:5173

# 限流
RATE_LIMIT_MAX=100

# 阿里云 OSS
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ROLE_ARN=acs:ram::your-account-id:role/your-role-name

# 高德地图 API
AMAP_API_KEY=your-amap-api-key

# AI - 阿里云百炼
DASHSCOPE_API_KEY=your-dashscope-api-key
AI_MODEL_NAME=kimi-k2.6
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_ENABLE_THINKING=false
AI_TEMPERATURE=0.6
AI_TIMEOUT=30000
AI_MAX_RETRIES=2

# MCP 服务
MCP_ENABLED=true
MCP_SERVER_PATH=mcp-servers/web-search-mcp/dist/index.js
MCP_SEARCH_MAX_RESULTS=8
MCP_FETCH_MAX_PAGES=3
