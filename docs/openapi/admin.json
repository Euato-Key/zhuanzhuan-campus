{"openapi": "3.0.3", "info": {"title": "管理员后台 API", "description": "转转校园二手平台 - 管理员后台仪表盘与统计接口文档", "version": "1.0.0"}, "servers": [{"url": "http://localhost:3000", "description": "开发环境"}], "tags": [{"name": "管理员仪表盘", "description": "数据概览与图表统计（需管理员权限）"}], "paths": {"/api/admin/dashboard": {"get": {"tags": ["管理员仪表盘"], "summary": "获取仪表盘概览数据", "description": "获取平台核心统计数据：用户数、商品数、订单数、交易额、今日新增等，以及最近举报活动和待审核商品", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/DashboardStats"}}}}}}, "401": {"description": "未登录"}, "403": {"description": "无权限（非管理员）"}}}}, "/api/admin/dashboard/charts": {"get": {"tags": ["管理员仪表盘"], "summary": "获取图表统计数据", "description": "获取7天趋势图数据：用户注册趋势、订单与营收趋势、商品状态分布、分类分布", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/ChartStats"}}}}}}, "401": {"description": "未登录"}, "403": {"description": "无权限（非管理员）"}}}}}, "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}}, "schemas": {"DashboardStats": {"type": "object", "properties": {"totalUsers": {"type": "integer", "description": "总用户数", "example": 1250}, "newUsersToday": {"type": "integer", "description": "今日新增用户", "example": 15}, "totalProducts": {"type": "integer", "description": "总商品数", "example": 890}, "pendingReviewProducts": {"type": "integer", "description": "待审核商品数", "example": 23}, "totalOrders": {"type": "integer", "description": "总订单数", "example": 456}, "pendingPaymentOrders": {"type": "integer", "description": "待支付订单数", "example": 12}, "totalRevenue": {"type": "number", "description": "总交易额（元）", "example": 125680.5}, "recentActivities": {"type": "array", "description": "最近举报活动", "items": {"type": "object", "properties": {"id": {"type": "string"}, "time": {"type": "string", "format": "date-time"}, "content": {"type": "string"}, "type": {"type": "string", "example": "report"}, "targetType": {"type": "string"}, "targetId": {"type": "string"}}}}, "pendingProducts": {"type": "array", "description": "待审核商品", "items": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "seller": {"type": "string"}, "time": {"type": "string", "format": "date-time"}}}}}}, "ChartStats": {"type": "object", "properties": {"userTrend": {"type": "object", "description": "7天用户注册趋势", "properties": {"dates": {"type": "array", "items": {"type": "string"}, "example": ["5/18", "5/19", "5/20", "5/21", "5/22", "5/23", "5/24"]}, "values": {"type": "array", "items": {"type": "integer"}, "example": [5, 8, 12, 6, 15, 9, 10]}}}, "orderTrend": {"type": "object", "description": "7天订单与营收趋势", "properties": {"dates": {"type": "array", "items": {"type": "string"}}, "counts": {"type": "array", "items": {"type": "integer"}, "description": "每日订单数"}, "revenues": {"type": "array", "items": {"type": "number"}, "description": "每日营收（元）"}}}, "productStatus": {"type": "array", "description": "商品状态分布", "items": {"type": "object", "properties": {"name": {"type": "string", "example": "在售"}, "value": {"type": "integer", "example": 650}}}}, "categoryDistribution": {"type": "array", "description": "商品分类分布（Top 8）", "items": {"type": "object", "properties": {"name": {"type": "string", "example": "手机数码"}, "value": {"type": "integer", "example": 230}}}}}}}}}