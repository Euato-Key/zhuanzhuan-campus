{
  "openapi": "3.0.3",
  "info": {
    "title": "转转校园 - 用户信息管理 API",
    "version": "1.0.0",
    "description": "用户资料修改、密码修改、邮箱修改、头像更新、获取公开资料。头像采用前端直传OSS temp目录 + 后端移动到正式路径的方式。"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "开发环境" }
  ],
  "tags": [
    { "name": "用户", "description": "用户信息管理接口" }
  ],
  "paths": {
    "/api/users/profile": {
      "put": {
        "tags": ["用户"],
        "summary": "修改个人信息",
        "description": "修改用户名、学校、校区、手机号、个人简介。修改用户名时会检查唯一性。修改手机号时会校验格式。",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "minLength": 2, "maxLength": 50, "description": "用户名" },
                  "school": { "type": "string", "maxLength": 100, "description": "学校名称" },
                  "campus": { "type": "string", "maxLength": 100, "description": "校区名称" },
                  "phone": { "type": "string", "description": "手机号（1开头11位）" },
                  "bio": { "type": "string", "maxLength": 500, "description": "个人简介" }
                }
              },
              "example": {
                "username": "new_name",
                "school": "北京大学",
                "campus": "海淀校区",
                "phone": "13800138000",
                "bio": "大家好！"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UserProfile" } } }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/users/password": {
      "put": {
        "tags": ["用户"],
        "summary": "修改密码",
        "description": "需验证旧密码。修改成功后吊销所有Refresh Token，需重新登录。",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["oldPassword", "newPassword"],
                "properties": {
                  "oldPassword": { "type": "string", "description": "旧密码" },
                  "newPassword": { "type": "string", "minLength": 6, "description": "新密码（至少6位）" }
                }
              },
              "example": { "oldPassword": "old123", "newPassword": "new456" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "code": 200, "data": null, "message": "修改密码成功，请重新登录" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/users/email": {
      "put": {
        "tags": ["用户"],
        "summary": "修改邮箱",
        "description": "需先调用 POST /api/auth/send-code（type=change_email, email=新邮箱）获取验证码。修改成功后吊销所有Refresh Token，需重新登录。",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["newEmail", "code"],
                "properties": {
                  "newEmail": { "type": "string", "format": "email", "description": "新邮箱" },
                  "code": { "type": "string", "minLength": 6, "maxLength": 6, "description": "6位验证码" }
                }
              },
              "example": { "newEmail": "new@example.com", "code": "123456" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "code": 200, "data": null, "message": "修改邮箱成功，请重新登录" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/users/avatar": {
      "put": {
        "tags": ["用户"],
        "summary": "更新头像",
        "description": "前端先通过 STS 凭证上传到 temp 目录，然后调用此接口传入 temp 路径。后端将文件从 temp 移动到正式路径，并将正式相对路径存入数据库。temp 路径格式：avatars/{userId}/temp/{timestamp}_{random}.{ext}",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tempPath"],
                "properties": {
                  "tempPath": { "type": "string", "description": "OSS临时文件相对路径" }
                }
              },
              "example": { "tempPath": "avatars/3/temp/1747123456789_abc123.jpg" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/UserProfile" } } }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "id": 3,
                    "email": "user@example.com",
                    "username": "campus_user",
                    "avatar": "avatars/3/2026/05/15/1747123456789_def456.jpg",
                    "bio": null,
                    "school": null,
                    "campus": null,
                    "phone": null,
                    "role": "user",
                    "creditScore": 100,
                    "createdAt": "2026-05-14T00:00:00.000Z"
                  },
                  "message": "更新头像成功"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["用户"],
        "summary": "获取用户公开资料",
        "description": "无需登录。返回用户名、头像、简介、学校、校区、信用分等公开信息，不包含邮箱和手机号。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "用户ID"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PublicProfile" } } }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "在请求头中携带 Access Token，格式：Bearer <token>"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "data": { "description": "响应数据" },
          "message": { "type": "string", "example": "success" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "data": { "type": "object", "nullable": true },
          "message": { "type": "string" }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string" },
          "username": { "type": "string" },
          "avatar": { "type": "string", "nullable": true, "description": "头像相对路径" },
          "bio": { "type": "string", "nullable": true },
          "school": { "type": "string", "nullable": true },
          "campus": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["user", "admin", "super_admin"] },
          "creditScore": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PublicProfile": {
        "type": "object",
        "description": "不包含邮箱、手机号等敏感信息",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "avatar": { "type": "string", "nullable": true, "description": "头像相对路径" },
          "bio": { "type": "string", "nullable": true },
          "school": { "type": "string", "nullable": true },
          "campus": { "type": "string", "nullable": true },
          "creditScore": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 400, "data": null, "message": "旧密码和新密码不能为空" }
          }
        }
      },
      "Unauthorized": {
        "description": "未认证",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 401, "data": null, "message": "未登录" }
          }
        }
      },
      "Forbidden": {
        "description": "无权操作",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 403, "data": null, "message": "临时文件路径不属于当前用户" }
          }
        }
      },
      "NotFound": {
        "description": "用户不存在",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 404, "data": null, "message": "用户不存在" }
          }
        }
      },
      "Conflict": {
        "description": "资源冲突",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 409, "data": null, "message": "该用户名已被使用" }
          }
        }
      }
    }
  }
}