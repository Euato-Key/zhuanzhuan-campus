{"openapi": "3.0.3", "info": {"title": "高校模块 API", "description": "转转校园二手平台 - 全国普通高等学校查询接口文档", "version": "1.0.0"}, "servers": [{"url": "http://localhost:3000", "description": "开发环境"}], "tags": [{"name": "高校接口", "description": "全国普通高等学校查询接口（无需登录）"}], "paths": {"/api/universities/search": {"get": {"tags": ["高校接口"], "summary": "搜索高校", "description": "按关键词、省份、办学层次搜索高校，支持分页", "parameters": [{"name": "keyword", "in": "query", "required": false, "description": "学校名称关键词（模糊匹配）", "schema": {"type": "string", "example": "北京"}}, {"name": "province", "in": "query", "required": false, "description": "省份（精确匹配）", "schema": {"type": "string", "example": "北京"}}, {"name": "level", "in": "query", "required": false, "description": "办学层次", "schema": {"type": "string", "enum": ["本科", "专科"]}}, {"name": "page", "in": "query", "required": false, "description": "页码（默认1）", "schema": {"type": "integer", "minimum": 1, "example": 1}}, {"name": "pageSize", "in": "query", "required": false, "description": "每页条数（默认10，最大50）", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "example": 10}}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"type": "object", "properties": {"list": {"type": "array", "items": {"$ref": "#/components/schemas/UniversityItem"}}, "total": {"type": "integer", "example": 2919}, "page": {"type": "integer", "example": 1}, "pageSize": {"type": "integer", "example": 10}, "totalPages": {"type": "integer", "example": 292}}}}}}}}}}}, "/api/universities/provinces": {"get": {"tags": ["高校接口"], "summary": "获取有高校的省份列表", "description": "返回所有有高校的省份名称，用于下拉筛选", "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"type": "array", "items": {"type": "string"}, "example": ["北京", "天津", "河北"]}}}}}}}}}, "/api/universities/list": {"get": {"tags": ["高校接口"], "summary": "按省份获取高校列表", "description": "根据省份获取该省所有高校，用于级联选择", "parameters": [{"name": "province", "in": "query", "required": true, "description": "省份名称", "schema": {"type": "string", "example": "北京"}}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/UniversityBrief"}}}}}}}, "400": {"description": "参数错误", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 400}, "message": {"type": "string", "example": "请提供省份参数"}, "data": {"type": "null"}}}}}}}}}}, "components": {"schemas": {"UniversityItem": {"type": "object", "description": "高校搜索结果项", "properties": {"id": {"type": "integer", "description": "主键ID", "example": 1}, "name": {"type": "string", "description": "学校名称", "example": "北京大学"}, "code": {"type": "string", "description": "学校标识码", "example": "4111010001"}, "province": {"type": "string", "description": "省份", "example": "北京"}, "city": {"type": "string", "description": "城市", "example": "北京市"}, "level": {"type": "string", "description": "办学层次", "enum": ["本科", "专科"], "example": "本科"}}}, "UniversityBrief": {"type": "object", "description": "高校简要信息（按省份查询返回）", "properties": {"id": {"type": "integer", "description": "主键ID", "example": 1}, "name": {"type": "string", "description": "学校名称", "example": "北京大学"}, "code": {"type": "string", "description": "学校标识码", "example": "4111010001"}, "city": {"type": "string", "description": "城市", "example": "北京市"}, "level": {"type": "string", "description": "办学层次", "enum": ["本科", "专科"], "example": "本科"}}}}}}