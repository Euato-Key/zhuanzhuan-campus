{"openapi": "3.0.3", "info": {"title": "系统配置模块 API", "description": "转转校园二手平台 - 系统配置模块接口文档（管理员专用）", "version": "1.0.0"}, "servers": [{"url": "http://localhost:3000", "description": "开发环境"}], "tags": [{"name": "系统配置", "description": "系统配置查看与修改（管理员/超级管理员）"}], "paths": {"/api/settings": {"get": {"tags": ["系统配置"], "summary": "获取系统配置", "description": "获取当前系统配置项，包括AI审核开关、AI助手上下文窗口大小等。需要管理员及以上权限。", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/SystemSettings"}}}}}}, "401": {"description": "未登录"}, "403": {"description": "无权限（非管理员）"}}}, "put": {"tags": ["系统配置"], "summary": "修改系统配置", "description": "修改系统配置项，仅超级管理员可操作。只需传入需要修改的字段，未传的字段保持不变。", "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateSettingsRequest"}}}}, "responses": {"200": {"description": "修改成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "更新成功"}, "data": {"$ref": "#/components/schemas/SystemSettings"}}}}}}, "400": {"description": "参数错误"}, "401": {"description": "未登录"}, "403": {"description": "无权限（非超级管理员）"}}}}}, "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}}, "schemas": {"SystemSettings": {"type": "object", "properties": {"ai_audit_enabled": {"type": "boolean", "description": "AI审核总开关", "example": false}, "ai_audit_first_publish": {"type": "boolean", "description": "首次发布启用AI审核", "example": false}, "ai_audit_edit": {"type": "boolean", "description": "编辑商品启用AI审核", "example": false}, "ai_assistant_context_window": {"type": "integer", "description": "AI助手上下文窗口大小（消息条数，3-20）", "example": 5}}}, "UpdateSettingsRequest": {"type": "object", "description": "只需传入需要修改的字段", "properties": {"ai_audit_enabled": {"type": "boolean", "description": "AI审核总开关"}, "ai_audit_first_publish": {"type": "boolean", "description": "首次发布启用AI审核"}, "ai_audit_edit": {"type": "boolean", "description": "编辑商品启用AI审核"}, "ai_assistant_context_window": {"type": "integer", "minimum": 3, "maximum": 20, "description": "AI助手上下文窗口大小（消息条数）"}}}}}}