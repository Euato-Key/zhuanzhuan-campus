{"openapi": "3.0.3", "info": {"title": "举报模块 API", "description": "转转校园二手平台 - 举报模块接口文档", "version": "1.0.0"}, "servers": [{"url": "http://localhost:3000", "description": "开发环境"}], "tags": [{"name": "用户举报接口", "description": "用户提交和查看举报（需登录）"}, {"name": "管理员举报接口", "description": "管理员查看和处理举报（需管理员权限）"}], "paths": {"/api/reports": {"post": {"tags": ["用户举报接口"], "summary": "提交举报", "description": "用户提交举报，支持商品、用户、评价、求购贴、评论等类型", "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateReportRequest"}}}}, "responses": {"201": {"description": "举报成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "举报成功"}, "data": {"$ref": "#/components/schemas/Report"}}}}}}, "400": {"description": "参数错误"}, "401": {"description": "未登录"}}}}, "/api/reports/my": {"get": {"tags": ["用户举报接口"], "summary": "获取我的举报列表", "description": "获取当前用户提交的举报列表，支持分页", "security": [{"bearerAuth": []}], "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}, "description": "页码"}, {"name": "pageSize", "in": "query", "schema": {"type": "integer", "default": 10}, "description": "每页数量"}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/PaginatedReportList"}}}}}}}}}, "/api/reports/my/{id}": {"get": {"tags": ["用户举报接口"], "summary": "获取我的举报详情", "description": "获取当前用户提交的指定举报详情", "security": [{"bearerAuth": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}, "description": "举报ID"}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/ReportDetail"}}}}}}, "403": {"description": "无权查看此举报"}, "404": {"description": "举报不存在"}}}}, "/api/reports/admin/list": {"get": {"tags": ["管理员举报接口"], "summary": "获取举报列表（管理员）", "description": "管理员查看所有举报，支持按类型、原因、状态筛选和关键词搜索", "security": [{"bearerAuth": []}], "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}, "description": "页码"}, {"name": "pageSize", "in": "query", "schema": {"type": "integer", "default": 10}, "description": "每页数量"}, {"name": "targetType", "in": "query", "schema": {"type": "string", "enum": ["product", "user", "review", "want_buy", "comment"]}, "description": "举报目标类型"}, {"name": "reason", "in": "query", "schema": {"type": "string", "enum": ["fraud", "prohibited", "inappropriate", "spam", "other"]}, "description": "举报原因"}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["pending", "dismissed", "warning", "banned", "resolved"]}, "description": "处理状态"}, {"name": "keyword", "in": "query", "schema": {"type": "string"}, "description": "搜索关键词"}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/PaginatedReportList"}}}}}}}}}, "/api/reports/admin/{id}": {"get": {"tags": ["管理员举报接口"], "summary": "获取举报详情（管理员）", "description": "管理员查看举报详细信息", "security": [{"bearerAuth": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}, "description": "举报ID"}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "success"}, "data": {"$ref": "#/components/schemas/ReportDetail"}}}}}}, "404": {"description": "举报不存在"}}}}, "/api/reports/admin/{id}/handle": {"put": {"tags": ["管理员举报接口"], "summary": "处理举报", "description": "管理员处理举报，可选操作：驳回(dismissed)、警告(warning)、封禁(banned)、已解决(resolved)。驳回操作可不填处理说明，其余操作必须填写。", "security": [{"bearerAuth": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}, "description": "举报ID"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HandleReportRequest"}}}}, "responses": {"200": {"description": "处理成功", "content": {"application/json": {"schema": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "message": {"type": "string", "example": "处理成功"}, "data": {"$ref": "#/components/schemas/Report"}}}}}}, "400": {"description": "参数错误（缺少处理说明等）"}, "404": {"description": "举报不存在"}}}}}, "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}}, "schemas": {"ReportTargetType": {"type": "string", "enum": ["product", "user", "review", "want_buy", "comment"], "description": "举报目标类型"}, "ReportReason": {"type": "string", "enum": ["fraud", "prohibited", "inappropriate", "spam", "other"], "description": "举报原因：欺诈/违规商品/不当内容/垃圾信息/其他"}, "ReportStatus": {"type": "string", "enum": ["pending", "dismissed", "warning", "banned", "resolved"], "description": "举报处理状态"}, "CreateReportRequest": {"type": "object", "required": ["targetType", "targetId", "reason"], "properties": {"targetType": {"$ref": "#/components/schemas/ReportTargetType"}, "targetId": {"type": "string", "description": "被举报对象ID"}, "reason": {"$ref": "#/components/schemas/ReportReason"}, "detail": {"type": "string", "description": "举报详情补充说明"}, "images": {"type": "array", "items": {"type": "string"}, "description": "举报截图"}}}, "HandleReportRequest": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["dismissed", "warning", "banned", "resolved"], "description": "处理结果"}, "handlerNote": {"type": "string", "description": "处理说明（驳回可留空，其余必填）"}}}, "Report": {"type": "object", "properties": {"id": {"type": "string", "description": "举报ID"}, "reporterId": {"type": "integer", "description": "举报人ID"}, "targetType": {"$ref": "#/components/schemas/ReportTargetType"}, "targetId": {"type": "string", "description": "被举报对象ID"}, "reason": {"$ref": "#/components/schemas/ReportReason"}, "detail": {"type": "string", "nullable": true}, "images": {"type": "array", "items": {"type": "string"}, "nullable": true}, "status": {"$ref": "#/components/schemas/ReportStatus"}, "handlerId": {"type": "integer", "nullable": true}, "handlerNote": {"type": "string", "nullable": true}, "handledAt": {"type": "string", "format": "date-time", "nullable": true}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}}, "ReportDetail": {"allOf": [{"$ref": "#/components/schemas/Report"}, {"type": "object", "properties": {"reporter": {"type": "object", "description": "举报人信息", "properties": {"id": {"type": "integer"}, "username": {"type": "string"}}}, "handler": {"type": "object", "nullable": true, "description": "处理人信息", "properties": {"id": {"type": "integer"}, "username": {"type": "string"}}}}}]}, "PaginatedReportList": {"type": "object", "properties": {"list": {"type": "array", "items": {"$ref": "#/components/schemas/Report"}}, "total": {"type": "integer"}, "page": {"type": "integer"}, "pageSize": {"type": "integer"}, "totalPages": {"type": "integer"}}}}}}