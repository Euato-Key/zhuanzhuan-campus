{
  "openapi": "3.0.3",
  "info": {
    "title": "收货地址模块 API",
    "description": "转转校园二手平台 - 收货地址模块接口文档",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "开发环境"
    }
  ],
  "tags": [
    {
      "name": "地址接口",
      "description": "收货地址相关接口（需登录）"
    }
  ],
  "paths": {
    "/api/addresses": {
      "get": {
        "tags": ["地址接口"],
        "summary": "获取地址列表",
        "description": "获取当前用户的所有收货地址，按默认地址优先排序",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Address" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["地址接口"],
        "summary": "创建收货地址",
        "description": "创建新的收货地址，最多20个。设为默认地址时自动取消其他默认地址",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAddressRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "地址创建成功" },
                    "data": { "$ref": "#/components/schemas/Address" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/addresses/{id}": {
      "get": {
        "tags": ["地址接口"],
        "summary": "获取地址详情",
        "description": "获取指定收货地址的详细信息",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "地址ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Address" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["地址接口"],
        "summary": "更新收货地址",
        "description": "更新指定收货地址的信息。设为默认地址时自动取消其他默认地址",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "地址ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateAddressRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "地址更新成功" },
                    "data": { "$ref": "#/components/schemas/Address" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["地址接口"],
        "summary": "删除收货地址",
        "description": "删除指定的收货地址",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "地址ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "地址删除成功" },
                    "data": { "type": "null" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/addresses/{id}/default": {
      "put": {
        "tags": ["地址接口"],
        "summary": "设为默认地址",
        "description": "将指定地址设为默认收货地址，自动取消其他默认地址",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "地址ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "设置成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "已设置为默认地址" },
                    "data": { "$ref": "#/components/schemas/Address" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": { "type": "integer", "example": 400 },
                "message": { "type": "string", "example": "请求参数错误" },
                "data": { "type": "null" }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未授权",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": { "type": "integer", "example": 401 },
                "message": { "type": "string", "example": "未授权" },
                "data": { "type": "null" }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "无权限",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": { "type": "integer", "example": 403 },
                "message": { "type": "string", "example": "无权限" },
                "data": { "type": "null" }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "code": { "type": "integer", "example": 404 },
                "message": { "type": "string", "example": "资源不存在" },
                "data": { "type": "null" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "地址ID" },
          "userId": { "type": "integer", "description": "用户ID" },
          "receiverName": { "type": "string", "description": "收货人姓名", "example": "张三" },
          "receiverPhone": { "type": "string", "description": "收货人手机号", "example": "13800138000" },
          "province": { "type": "string", "description": "省份", "example": "北京市" },
          "city": { "type": "string", "description": "城市", "example": "北京市" },
          "district": { "type": "string", "description": "区县", "example": "海淀区" },
          "street": { "type": "string", "nullable": true, "description": "街道/镇", "example": "中关村街道" },
          "detail": { "type": "string", "description": "详细地址", "example": "清华大学紫荆公寓6号楼" },
          "isDefault": { "type": "boolean", "description": "是否为默认地址" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateAddressRequest": {
        "type": "object",
        "required": ["receiverName", "receiverPhone", "province", "city", "district", "detail"],
        "properties": {
          "receiverName": {
            "type": "string",
            "description": "收货人姓名",
            "minLength": 2,
            "maxLength": 20,
            "example": "张三"
          },
          "receiverPhone": {
            "type": "string",
            "description": "收货人手机号（11位）",
            "pattern": "^1[3-9]\\d{9}$",
            "example": "13800138000"
          },
          "province": {
            "type": "string",
            "description": "省份",
            "example": "北京市"
          },
          "city": {
            "type": "string",
            "description": "城市",
            "example": "北京市"
          },
          "district": {
            "type": "string",
            "description": "区县",
            "example": "海淀区"
          },
          "street": {
            "type": "string",
            "description": "街道/镇（选填）",
            "maxLength": 50,
            "example": "中关村街道"
          },
          "detail": {
            "type": "string",
            "description": "详细地址",
            "minLength": 5,
            "maxLength": 100,
            "example": "清华大学紫荆公寓6号楼"
          },
          "isDefault": {
            "type": "boolean",
            "description": "是否设为默认地址",
            "default": false
          }
        }
      },
      "UpdateAddressRequest": {
        "type": "object",
        "properties": {
          "receiverName": {
            "type": "string",
            "description": "收货人姓名",
            "minLength": 2,
            "maxLength": 20
          },
          "receiverPhone": {
            "type": "string",
            "description": "收货人手机号（11位）",
            "pattern": "^1[3-9]\\d{9}$"
          },
          "province": {
            "type": "string",
            "description": "省份"
          },
          "city": {
            "type": "string",
            "description": "城市"
          },
          "district": {
            "type": "string",
            "description": "区县"
          },
          "street": {
            "type": "string",
            "description": "街道/镇（选填）",
            "maxLength": 50
          },
          "detail": {
            "type": "string",
            "description": "详细地址",
            "minLength": 5,
            "maxLength": 100
          },
          "isDefault": {
            "type": "boolean",
            "description": "是否设为默认地址"
          }
        }
      }
    }
  }
}