                ],
                "properties": {
                  "blockedUserId": {
                    "type": "integer",
                    "description": "要拉黑的用户ID"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "已拉黑该用户"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BlacklistItem"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "已经拉黑该用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "data": null,
                  "message": "已经拉黑了该用户"
                }
              }
            }
          }
        }
      }
