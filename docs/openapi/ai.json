{
  "openapi": "3.0.3",
  "info": {
    "title": "AI模块 API",
    "description": "转转校园二手平台 - AI智能识别、审核与助手模块接口文档",
    "version": "3.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "开发环境" }
  ],
  "tags": [
    { "name": "AI识别", "description": "AI商品图片识别" },
    { "name": "AI审核", "description": "AI商品审核（管理员）" },
    { "name": "AI助手", "description": "AI智能助手对话" }
  ],
  "paths": {
    "/api/ai/recognize": {
      "post": {
        "tags": ["AI识别"],
        "summary": "AI商品图片识别",
        "description": "上传商品图片，AI自动识别商品信息并返回结构化数据。支持MCP多阶段流程（图片识别→联网搜索→页面抓取→信息融合），MCP不可用时自动降级。",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["images"],
                "properties": {
                  "images": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 9, "description": "商品图片OSS路径" },
                  "name": { "type": "string", "description": "商品名称提示" },
                  "brand": { "type": "string", "description": "品牌提示" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "识别完成" },
          "400": { "description": "参数错误" },
          "401": { "description": "未登录" },
          "429": { "description": "AI服务繁忙" },
          "503": { "description": "AI服务不可用" }
        }
      }
    },
    "/api/ai/audit/{productId}": {
      "post": {
        "tags": ["AI审核"],
        "summary": "AI商品审核",
        "description": "对指定商品执行AI审核，返回审核结果（通过/不通过/风险评分等）",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "商品ID" }
        ],
        "responses": {
          "200": {
            "description": "审核结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "approved": { "type": "boolean" },
                        "skipped": { "type": "boolean" },
                        "riskScore": { "type": "number" },
                        "riskCategories": { "type": "array", "items": { "type": "string" } },
                        "details": { "type": "string" },
                        "suggestions": { "type": "array", "items": { "type": "string" } }
                      }
                    },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/audit/{productId}/status": {
      "get": {
        "tags": ["AI审核"],
        "summary": "获取商品审核状态",
        "description": "查询指定商品的当前审核状态、审核次数、拒绝原因等",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "商品ID" }
        ],
        "responses": {
          "200": {
            "description": "审核状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "status": { "type": "string", "enum": ["pending", "active", "offline", "banned", "audit_failed"] },
                        "rejectReason": { "type": "string", "nullable": true },
                        "auditCount": { "type": "integer" },
                        "relistCount": { "type": "integer" }
                      }
                    },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/assistant/chat": {
      "post": {
        "tags": ["AI助手"],
        "summary": "AI助手对话（SSE流式）",
        "description": "与AI助手进行对话，响应以SSE流式输出。事件类型：meta(会话ID)、token(文本片段)、card(商品/订单卡片)、status(工具调用状态)、done(完成)、error(错误)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "conversationId": { "type": "integer", "nullable": true, "description": "对话ID，为空则新建对话" },
                  "message": { "type": "string", "maxLength": 500, "description": "用户消息内容" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE流式响应",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/api/ai/assistant/conversations": {
      "get": {
        "tags": ["AI助手"],
        "summary": "获取用户对话列表",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "对话列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "title": { "type": "string" },
                          "createdAt": { "type": "string", "format": "date-time" },
                          "updatedAt": { "type": "string", "format": "date-time" }
                        }
                      }
                    },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/assistant/conversations/{id}/messages": {
      "get": {
        "tags": ["AI助手"],
        "summary": "获取对话消息列表",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "对话ID" }
        ],
        "responses": {
          "200": {
            "description": "消息列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "conversationId": { "type": "integer" },
                          "role": { "type": "string", "enum": ["user", "assistant"] },
                          "content": { "type": "string" },
                          "msgType": { "type": "string", "enum": ["text", "product_card", "order_card", "chart", "link", "mixed"] },
                          "extraData": { "type": "object", "nullable": true },
                          "createdAt": { "type": "string", "format": "date-time" }
                        }
                      }
                    },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/assistant/conversations/{id}": {
      "delete": {
        "tags": ["AI助手"],
        "summary": "删除对话",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "对话ID" }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  }
}