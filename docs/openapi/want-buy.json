{
  "openapi": "3.0.3",
  "info": {
    "title": "转转校园 - 求购社区 API",
    "version": "1.1.0",
    "description": "求购社区模块API文档，包含求购贴发布、管理、评论等功能"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "开发服务器"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "WantBuy": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "name": { "type": "string" },
          "categoryId": { "type": "integer", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" }, "nullable": true },
          "maxPrice": { "type": "number", "nullable": true },
          "status": { "type": "string", "enum": ["active", "found", "closed", "expired"] },
          "validDays": { "type": "integer" },
          "expireTime": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/UserBrief" },
          "category": { "$ref": "#/components/schemas/CategoryBrief", "nullable": true },
          "commentCount": { "type": "integer" }
        }
      },
      "UserBrief": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "avatar": { "type": "string", "nullable": true },
          "school": { "type": "string", "nullable": true },
          "campus": { "type": "string", "nullable": true }
        }
      },
      "CategoryBrief": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "wantBuyId": { "type": "integer" },
          "userId": { "type": "integer" },
          "parentId": { "type": "integer", "nullable": true },
          "content": { "type": "string" },
          "likeCount": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/CommentUser" },
          "isLiked": { "type": "boolean" },
          "replies": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } }
        }
      },
      "CommentUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "avatar": { "type": "string", "nullable": true }
        }
      },
      "PaginatedWantBuyList": {
        "type": "object",
        "properties": {
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/WantBuy" } },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "PaginatedCommentList": {
        "type": "object",
        "properties": {
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "CreateWantBuyRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 100, "description": "商品名称" },
          "categoryId": { "type": "integer", "description": "分类ID" },
          "description": { "type": "string", "description": "商品描述" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "标签" },
          "maxPrice": { "type": "number", "description": "期望最高价格" },
          "validDays": { "type": "integer", "enum": [7, 15, 30], "description": "有效期（天）" }
        }
      },
      "UpdateWantBuyRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 100 },
          "categoryId": { "type": "integer", "nullable": true },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "maxPrice": { "type": "number", "nullable": true },
          "validDays": { "type": "integer", "enum": [7, 15, 30] }
        }
      },
      "CreateCommentRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "maxLength": 500, "description": "评论内容" },
          "parentId": { "type": "integer", "description": "父评论ID（回复时必填）" }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "data": {},
          "message": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/want-buy": {
      "get": {
        "tags": ["求购贴"],
        "summary": "获取求购贴列表",
        "description": "获取公开的求购贴列表，支持筛选和分页",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" }, "description": "页码" },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" }, "description": "每页数量" },
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "搜索关键词" },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" }, "description": "分类ID" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["open", "found", "closed"] }, "description": "状态筛选" },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["time", "view", "comment"] }, "description": "排序方式" },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] }, "description": "排序方向" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaginatedWantBuyList" } } }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["求购贴"],
        "summary": "发布求购贴",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateWantBuyRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "发布成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/WantBuy" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/want-buy/my/list": {
      "get": {
        "tags": ["求购贴"],
        "summary": "获取我的求购贴列表",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["open", "found", "closed"] } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaginatedWantBuyList" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/want-buy/user/{userId}": {
      "get": {
        "tags": ["求购贴"],
        "summary": "获取用户发布的求购贴",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaginatedWantBuyList" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/want-buy/{id}": {
      "get": {
        "tags": ["求购贴"],
        "summary": "获取求购贴详情",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/WantBuy" } } }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["求购贴"],
        "summary": "修改求购贴",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateWantBuyRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/WantBuy" } } }
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["求购贴"],
        "summary": "删除求购贴",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    },
    "/api/want-buy/{id}/found": {
      "put": {
        "tags": ["求购贴"],
        "summary": "标记为已找到",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "标记成功" }
        }
      }
    },
    "/api/want-buy/{id}/close": {
      "put": {
        "tags": ["求购贴"],
        "summary": "关闭求购贴",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "关闭成功" }
        }
      }
    },
    "/api/want-buy/{id}/reopen": {
      "put": {
        "tags": ["求购贴"],
        "summary": "重新开启求购贴",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "重新开启成功" }
        }
      }
    },
    "/api/want-buy/{id}/comments": {
      "get": {
        "tags": ["评论"],
        "summary": "获取评论列表",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "求购贴ID" },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PaginatedCommentList" } } }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["评论"],
        "summary": "发表评论",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "求购贴ID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateCommentRequest" } }
          }
        },
        "responses": {
          "201": { "description": "评论成功" }
        }
      }
    },
    "/api/want-buy/comments/{commentId}": {
      "put": {
        "tags": ["评论"],
        "summary": "修改评论",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "修改成功" }
        }
      },
      "delete": {
        "tags": ["评论"],
        "summary": "删除评论",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    },
    "/api/want-buy/comments/{commentId}/like": {
      "post": {
        "tags": ["评论"],
        "summary": "点赞评论",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "点赞成功" }
        }
      },
      "delete": {
        "tags": ["评论"],
        "summary": "取消点赞",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "取消成功" }
        }
      }
    },
    "/api/want-buy/admin/list": {
      "get": {
        "tags": ["管理员"],
        "summary": "管理员-获取求购贴列表",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["open", "found", "closed"] } },
          { "name": "userId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/api/want-buy/admin/{id}": {
      "delete": {
        "tags": ["管理员"],
        "summary": "管理员-删除求购贴",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    },
    "/api/want-buy/admin/comments/{commentId}": {
      "delete": {
        "tags": ["管理员"],
        "summary": "管理员-删除评论",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "删除成功" }
        }
      }
    }
  }
}
