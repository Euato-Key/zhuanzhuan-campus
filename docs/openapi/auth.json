{
  "openapi": "3.0.3",
  "info": {
    "title": "转转校园 - 认证模块 API",
    "version": "1.0.0",
    "description": "邮箱验证码、注册、登录、Token刷新、退出登录、找回密码、获取个人信息。Refresh Token 通过 HttpOnly Cookie 传递，Access Token 通过 Bearer Header 传递。"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "开发环境" }
  ],
  "tags": [
    { "name": "认证", "description": "认证相关接口" }
  ],
  "paths": {
    "/api/auth/send-code": {
      "post": {
        "tags": ["认证"],
        "summary": "发送邮箱验证码",
        "description": "向指定邮箱发送6位数字验证码，5分钟内有效。同一邮箱1分钟内只能发送一次。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "type"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "接收验证码的邮箱"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["register", "login", "reset_password", "change_email"],
                    "description": "验证码类型：register-注册, login-登录, reset_password-重置密码, change_email-更换邮箱"
                  }
                }
              },
              "examples": {
                "注册": { "value": { "email": "user@example.com", "type": "register" } },
                "找回密码": { "value": { "email": "user@example.com", "type": "reset_password" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发送成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "code": 200, "data": null, "message": "验证码已发送" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": {
            "description": "发送太频繁",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "code": 429, "data": null, "message": "发送太频繁，请1分钟后再试" }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["认证"],
        "summary": "用户注册",
        "description": "使用邮箱+验证码+用户名+密码注册新账号。需先调用发送验证码接口获取验证码。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code", "username", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "description": "邮箱" },
                  "code": { "type": "string", "minLength": 6, "maxLength": 6, "description": "6位邮箱验证码" },
                  "username": { "type": "string", "minLength": 2, "maxLength": 50, "description": "用户名" },
                  "password": { "type": "string", "minLength": 6, "description": "密码（至少6位）" }
                }
              },
              "example": {
                "email": "user@example.com",
                "code": "123456",
                "username": "campus_user",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "integer", "example": 1 },
                            "email": { "type": "string", "example": "user@example.com" },
                            "username": { "type": "string", "example": "campus_user" }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 201,
                  "data": { "id": 1, "email": "user@example.com", "username": "campus_user" },
                  "message": "注册成功"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/auth/login/password": {
      "post": {
        "tags": ["认证"],
        "summary": "邮箱+密码登录",
        "description": "使用邮箱+密码登录。连续5次密码错误将锁定30分钟。登录成功返回 Access Token 并通过 Set-Cookie 设置 HttpOnly 的 Refresh Token。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "description": "邮箱" },
                  "password": { "type": "string", "description": "密码" }
                }
              },
              "example": { "email": "user@example.com", "password": "password123" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "refresh_token=xxx; HttpOnly; Path=/api/auth; SameSite=Lax; Max-Age=2592000"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/LoginData" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "access_token": "eyJhbGciOiJIUzI1NiIs...",
                    "user": {
                      "id": 1,
                      "email": "user@example.com",
                      "username": "campus_user",
                      "avatar": null,
                      "role": "user",
                      "creditScore": 100
                    }
                  },
                  "message": "登录成功"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "423": {
            "description": "账号被锁定",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "code": 423, "data": null, "message": "密码错误次数过多，请30分钟后再试" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login/code": {
      "post": {
        "tags": ["认证"],
        "summary": "邮箱+验证码登录",
        "description": "使用邮箱+验证码登录，免密码。需先调用发送验证码接口（type=login）获取验证码。登录成功返回 Access Token 并通过 Set-Cookie 设置 HttpOnly 的 Refresh Token。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code"],
                "properties": {
                  "email": { "type": "string", "format": "email", "description": "邮箱" },
                  "code": { "type": "string", "minLength": 6, "maxLength": 6, "description": "6位邮箱验证码" }
                }
              },
              "example": { "email": "user@example.com", "code": "123456" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "refresh_token=xxx; HttpOnly; Path=/api/auth; SameSite=Lax; Max-Age=2592000"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/LoginData" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "access_token": "eyJhbGciOiJIUzI1NiIs...",
                    "user": {
                      "id": 1,
                      "email": "user@example.com",
                      "username": "campus_user",
                      "avatar": null,
                      "role": "user",
                      "creditScore": 100
                    }
                  },
                  "message": "登录成功"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/auth/refresh-token": {
      "post": {
        "tags": ["认证"],
        "summary": "刷新Token",
        "description": "使用 Cookie 中的 Refresh Token 换取新的 Access Token。旧 Refresh Token 自动吊销（Token轮换机制），新 Refresh Token 通过 Set-Cookie 写回。",
        "responses": {
          "200": {
            "description": "刷新成功",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "refresh_token=xxx; HttpOnly; Path=/api/auth; SameSite=Lax; Max-Age=2592000"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "access_token": { "type": "string", "description": "新的Access Token" }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": { "access_token": "eyJhbGciOiJIUzI1NiIs..." },
                  "message": "Token刷新成功"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "退出登录",
        "description": "吊销 Cookie 中的 Refresh Token，并清除 Cookie。需携带 Access Token。",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "退出成功",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "refresh_token=; HttpOnly; Path=/api/auth; Max-Age=0 (清除Cookie)"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "code": 200, "data": null, "message": "已退出登录" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": ["认证"],
        "summary": "重置密码（找回密码）",
        "description": "通过邮箱验证码重置密码。需先调用发送验证码接口（type=reset_password）。重置后所有Refresh Token自动吊销，Cookie清除。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code", "new_password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "description": "注册邮箱" },
                  "code": { "type": "string", "minLength": 6, "maxLength": 6, "description": "6位验证码" },
                  "new_password": { "type": "string", "minLength": 6, "description": "新密码（至少6位）" }
                }
              },
              "example": {
                "email": "user@example.com",
                "code": "654321",
                "new_password": "newpassword123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "重置成功",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "refresh_token=; HttpOnly; Path=/api/auth; Max-Age=0 (清除Cookie)"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "code": 200, "data": null, "message": "密码重置成功" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": ["认证"],
        "summary": "获取当前用户信息",
        "description": "需要登录，通过Access Token获取当前用户资料。",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/UserProfile" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "data": {
                    "id": 1,
                    "email": "user@example.com",
                    "username": "campus_user",
                    "avatar": null,
                    "bio": null,
                    "school": null,
                    "campus": null,
                    "phone": null,
                    "role": "user",
                    "creditScore": 100,
                    "createdAt": "2026-05-14T00:00:00.000Z"
                  },
                  "message": "success"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "在请求头中携带 Access Token，格式：Bearer <token>"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "data": { "description": "响应数据" },
          "message": { "type": "string", "example": "success" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "data": { "type": "object", "nullable": true },
          "message": { "type": "string" }
        }
      },
      "LoginData": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string", "description": "访问令牌，60分钟有效" },
          "user": { "$ref": "#/components/schemas/LoginUser" }
        }
      },
      "LoginUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "email": { "type": "string", "example": "user@example.com" },
          "username": { "type": "string", "example": "campus_user" },
          "avatar": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["user", "admin", "super_admin"], "example": "user" },
          "creditScore": { "type": "integer", "example": 100 }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string" },
          "username": { "type": "string" },
          "avatar": { "type": "string", "nullable": true },
          "bio": { "type": "string", "nullable": true },
          "school": { "type": "string", "nullable": true },
          "campus": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["user", "admin", "super_admin"] },
          "creditScore": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 400, "data": null, "message": "验证码错误" }
          }
        }
      },
      "Unauthorized": {
        "description": "未认证",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 401, "data": null, "message": "未登录" }
          }
        }
      },
      "Forbidden": {
        "description": "账号被封禁",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 403, "data": null, "message": "账号已被封禁" }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 404, "data": null, "message": "该邮箱未注册" }
          }
        }
      },
      "Conflict": {
        "description": "资源冲突",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "code": 409, "data": null, "message": "该邮箱已注册" }
          }
        }
      }
    }
  }
}